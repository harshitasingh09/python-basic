    "import os\n",
    "\n",
    "filename = input(\"Enter the filename to open: \")\n",
    "\n",
    "if os.path.exists(filename):\n",
    "    with open(filename, \"r\") as file:\n",
    "        content = file.read()\n",
    "\n",
    "    print(\"\\nFile Contents:\")\n",
    "    print(content)\n",
    "\n",
    "else:\n",
    "    print(\"File not found. Please check the filename.\")"
