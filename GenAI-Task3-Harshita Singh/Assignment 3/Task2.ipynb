   "source": [
    "def factorial(n):\n",
    "    if n < 0:\n",
    "        return \"Input should be a positive integer\"\n",
    "    elif n == 0 or n == 1:\n",
    "        return 1\n",
    "    else:\n",
    "        return n * factorial(n-1)"
   ]
  },
